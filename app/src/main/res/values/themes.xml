<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 墨水屏主题：纯黑白、无窗口动画、无转场、无按钮阴影动画 -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:colorPrimary">#FFFFFF</item>
        <!-- Android 5.x 不支持浅色状态栏图标，用黑色状态栏保证可见 -->
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:colorControlNormal">#000000</item>
        <item name="android:colorControlActivated">#000000</item>
        <item name="android:colorControlHighlight">#22000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#222222</item>
        <item name="android:textColorHint">#666666</item>
        <item name="android:buttonStyle">@style/EinkButton</item>
        <item name="android:alertDialogTheme">@style/EinkDialog</item>
        <item name="android:dialogTheme">@style/EinkDialog</item>
        <item name="android:scrollbarFadeDuration">0</item>
    </style>

    <style name="EinkDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:colorControlActivated">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#222222</item>
        <item name="android:buttonStyle">@style/EinkButton</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="EinkButton" parent="android:Widget.Material.Light.Button.Borderless">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <style name="ReaderTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
